@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div>
    <h3>Profile</h3>
    <div class="row">
        <partial name="_StatusMessage" for="StatusMessage" />
        <form id="profile-form" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-red-400" role="alert"></div>
            <div class="form-floating mb-3">
                <input class="form-control" asp-for="Username" disabled />
                <label class="form-label" asp-for="Username"></label>
            </div>
            <div class="form-floating mb-3">
                <label asp-for="Input.PhoneNumber" class="form-label"></label>
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Please enter your phone number." />
                <span asp-validation-for="Input.PhoneNumber" class="text-red-400"></span>
            </div>
            <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary">Save</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
