@page
@model ApiKeyModel
@{
    ViewData["Title"] = "API Key";
}
<div class="space-y-5 w-3/4">
    <div class="space-y-2">
        <h3>
            @(String.IsNullOrEmpty(@Model?.Input?.ApiKey) ? "Generate API Key" : "Manage API Key")
        </h3>
        <h2>Select the generate key button to create your API Key.</h2>
    </div>
    <form method="post" class="space-y-4">
        <div class="space-x-2 form-floating">
            <input class="form-control" asp-for="Input.ApiKey" placeholder="No key" disabled />
            <label class="form-label" asp-for="Input.ApiKey"></label>
            <button id="copyButton" onclick="handleCopy()" type="button"
                    class="text-sm font-semibold underline underline-offset-3 p-1 rounded-lg cursor-pointer">Copy</button>
        </div>
        @if (!String.IsNullOrEmpty(@Model?.Input?.ApiKey) && @Model.Input.IsActive)
        {
            <button type="submit" class="btn btn-lg btn-primary" disabled>Generate key</button>
        }
        else
        {
            if (@Model?.Input != null && !@Model.Input.IsActive)
            {
                <p class="text-red-400">Key is invalid</p>
            }
            <button type="submit" class="btn btn-lg btn-primary cursor-pointer">Generate key</button>
        }
    </form>
</div>

<script>
    let timeoutId = null;
    function handleCopy() {
        const copyText = document.getElementById("Input_ApiKey");
        const copyButton = document.getElementById("copyButton");
        // Select the text field
        copyText.select();
        copyText.setSelectionRange(0, 99999); // For mobile devices
        // copy the text inside the text field
        navigator.clipboard.writeText(copyText.value);

        copyButton.textContent = "Copied";
        if (timeoutId != null) clearTimeout(timeoutId);
        timeoutId = setTimeout(() => {
            copyButton.textContent = "Copy";
            timeoutId = null;
        }, 4000);
    }
</script>