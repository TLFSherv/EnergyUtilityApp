@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="space-y-8">
    <div class="text-xl space-y-4 w-1/2 mx-auto mt-16">
        <h1 class="text-5xl pb-4 font-medium font-[Arial] border-b">@ViewData["Title"]</h1>
        <h2>Use a local account to log in.</h2>
        <section>
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="space-y-4">
                    <div class="form-floating">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true"
                               placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password"
                               aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="checkbox mb-3 form-floating space-x-1">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label asp-for="Input.RememberMe" class="form-check-label"></label>
                    </div>
                </div>
                <div>
                    <button id="login-submit" type="submit"
                            class="rounded-lg w-1/2 bg-[#2496FA] text-white text-2xl py-2 font-light mb-4 cursor-pointer">
                        Log in</button>
                    </div>
                    @* <div class="text-[#2496FA] text-base space-y-1">
                        <p>
                            <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
                        </p>
                        <p>
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a>
                        </p>
                        <p>
                            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
                        </p>
                    </div> *@
                </form>
            </section>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
