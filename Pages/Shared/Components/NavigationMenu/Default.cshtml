                    <button class="cursor-pointer" type="submit">Logout</button>
                </form>
            </li>
        </ul>
    </div>
</div>

<div class="w-full bg-[#171717] md:hidden">
    <div class="topnav flex md:hidden h-16 w-full px-8 border-b border-[#BBBABA]">
        <div class="my-auto">
            <a href="/">
                <img src="~/images/logo-white.png" alt="logo" class="size-8 w-auto" />
            </a>
        </div>
        <div class="flex-1"></div>
        <div class="my-auto">
            <a href="javascript:void(0);" class="icon" onclick="toggleMenu()">
                <img src="~/images/hamburger-white.png" alt="icon" class="size-10" />
            </a>
        </div>
    </div>
    <ol id="menuLinks" class="hidden text-white text-xl font-light">
        <a href="/HowToUse">
            <li class="w-full py-4 px-8  hover:bg-[#454545] cursor-pointer ">
                Use API
            </li>
        </a>
        <a href="/Contact">
            <li class="w-full py-4 px-8 hover:bg-[#454545] cursor-pointer ">
                Contact Us
            </li>
        </a>
        <a href="/Resources">
            <li class="w-full py-4 px-8 hover:bg-[#454545] cursor-pointer ">
                Data Resources
            </li>
        </a>
        <a asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
            <li class="w-full py-4 px-8 hover:bg-[#454545] cursor-pointer ">
                My Account
            </li>
        </a>
        <form asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" asp-area="Identity"
              method="post">
            <li class="w-full py-4 px-8 hover:bg-[#454545]">
                <button type="submit" class="w-full text-left cursor-pointer">Logout</button>
            </li>
        </form>
    </ol>
</div>






