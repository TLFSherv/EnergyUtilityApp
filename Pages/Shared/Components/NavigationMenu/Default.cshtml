<!-- Navigation -->
<div class="hidden md:flex h-16 w-full px-4 border-b border-[#BBBABA]">
    <div class="text-lg sm:text-xl">
        <ul class="flex items-center space-x-4 sm:space-x-8 h-full">
            <li>
                <a href="/">
                    <img src="~/images/logo.png" alt="logo" class="size-8 w-auto" />
                </a>
            </li>
            <li><a href="/HowToUse">Use API</span></a></li>
            <li><a href="/Contact">Contact Us</span></a></li>
            <li><a href="/Resources">Data Resources</span></a></li>
        </ul>
    </div>
    <div class="flex-1"></div>
    <div class="my-auto">
        <ul>
            <li>
                <a asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                    My Account
                </a>
            </li>
            <li>
                <form asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })"
